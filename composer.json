{
    "name": "smithy/client",
    "description": "Schema-driven client runtime for generated and runtime-loaded Smithy services.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "ext-ctype": "*",
        "ext-filter": "*",
        "mtdowling/jmespath.php": "^2.9.1",
        "php": ">=8.2",
        "psr/http-message": "^2.0",
        "smithy/async": "self.version",
        "smithy/auth": "self.version",
        "smithy/core": "self.version",
        "smithy/http": "self.version",
        "smithy/protocol": "self.version"
    },
    "suggest": {
        "ext-zlib": "Enables gzip request compression."
    },
    "autoload": {
        "psr-4": {
            "Smithy\\Client\\": ""
        }
    }
}
